# 環境變數範本 —— 複製成 .env（本機開發用），或到 Render 的 Environment 設定。
# 只列變數名稱與說明，切勿在此填入真實密鑰，也切勿把 .env 推上 GitHub。

# 【必填】Django 密鑰。請用一組長且隨機的值（見 README 或用指令產生）。
DJANGO_SECRET_KEY=

# 資料庫連線字串（PostgreSQL）。
# - 正式環境（Render）：貼上 Render 資料庫的 Internal Database URL。
# - 本機開發：留空即可，系統會自動改用 SQLite（db.sqlite3）。
# 範例格式：postgres://使用者:密碼@主機:5432/資料庫名
DATABASE_URL=

# 正式環境維持 False；本機想看除錯畫面才設 True。
DJANGO_DEBUG=False

# 允許的主機（逗號分隔）。Render 網域會自動納入，通常本機可留預設。
# 若有自訂網域再加，例如：museum.example.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 套上 HTTPS 後設 True，啟用 SSL 轉址與 secure cookie（Render 有 HTTPS，正式環境建議 True）。
DJANGO_HTTPS=True

# 選填：額外的 CSRF 信任來源（含 https://），逗號分隔。Render 網域會自動納入，通常留空即可。
DJANGO_CSRF_TRUSTED_ORIGINS=

# 部署時自動建立管理員帳號（供無法用 Shell 的環境）。三者都設才會建立；未設則略過。
# 帳號建立後可視需要移除 PASSWORD 這個環境變數。
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
